# Reference for process environment variables, not an automatically loaded file.
# The Windows launcher creates its own local database and credentials by default.

# Manual PostgreSQL setup only: replace all placeholder values before use.
# LINSEMAIL_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/linsemail

LINSEMAIL_PORT=8100
LINSEMAIL_SMTP_PORT=1025
LINSEMAIL_LOCAL_SESSION=1
# Optional absolute path; defaults to .runtime under the checkout.
# LINSEMAIL_RUNTIME=/ABSOLUTE/PATH/TO/RUNTIME
